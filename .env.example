# ==========================================
# SAGO 백엔드 - 환경 변수 템플릿
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
# 실제 키가 든 .env 는 절대 Git 에 커밋하지 말 것! (.gitignore 처리됨)
# ==========================================

# ---------- Server ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local          # local | dev | prod

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accident_service
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ---------- JWT ----------
JWT_SECRET=change_me_to_a_long_random_string_at_least_256_bits
JWT_ACCESS_EXPIRATION=3600000         # 1시간 (ms)
JWT_REFRESH_EXPIRATION=1209600000     # 14일 (ms)

# ---------- OAuth - Kakao ----------
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:8080/auth/social/kakao/callback

# ---------- OAuth - Google ----------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/social/google/callback

# ---------- Gemini API ----------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_REQUEST_LIMIT=250
GEMINI_RPM_LIMIT=10

# ---------- Google Cloud STT ----------
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-stt-service-account.json
STT_LANGUAGE_CODE=ko-KR
STT_MONTHLY_FREE_SECONDS=3600

# ---------- AWS S3 ----------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=accident-service-files
